# ============================================================
#  .env.example  —  Environment variables for Echoes Intel
# ------------------------------------------------------------
#  Copy this file to ".env" and fill in your real values.
#  The ".env" file is git-ignored so your secrets never get
#  committed by accident.
#
#  How to use it:
#    1.  cp .env.example .env
#    2.  Edit .env and put in your real database details
#    3.  Run the server — it reads these automatically
#
#  The server (server.py) will refuse to start if any of
#  these are missing. That's on purpose, so you never
#  accidentally run with no database configured.
# ============================================================

# Your MySQL database host (e.g. sql.freesqldatabase.com or localhost)
ECHOES_DB_HOST=

# The database username
ECHOES_DB_USER=

# The database password
ECHOES_DB_PASS=

# The database / schema name
ECHOES_DB_NAME=
